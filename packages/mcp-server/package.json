{
  "name": "@codemap-ai/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CodeMap — AI-powered code intelligence and coding agent CLI",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "codemap": "dist/index.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    "agent-pack",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "build:tsc": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:watch": "tsx watch src/index.ts",
    "test": "tsx test/semantic-tools.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@codemap/code-index": "workspace:*",
    "@codemap/shared": "workspace:*",
    "@earendil-works/pi-tui": "^0.74.0",
    "@git-diff-view/core": "^0.1.3",
    "@mastra/mcp": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "ai": "^6.0.176",
    "cfonts": "^3.3.1",
    "execa": "^9.6.1",
    "jszip": "^3.10.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "mastracode": "^0.19.1",
    "shiki": "^4.0.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mastra/core": "^1.35.0",
    "@types/node": "^24.12.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
