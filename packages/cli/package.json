{
  "name": "@codemap-ai/cli",
  "version": "0.2.0",
  "type": "module",
  "description": "CodeMap — AI-powered coding agent CLI",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "codemap": "dist/index.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    "agent-pack",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "build:tsc": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:watch": "tsx watch src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.63",
    "@clack/prompts": "^1.5.0",
    "@codemap-ai/mcp": "workspace:*",
    "@codemap-ai/core": "workspace:*",
    "@earendil-works/pi-tui": "^0.74.0",
    "@mastra/fastembed": "1.1.2",
    "@mastra/libsql": "1.12.1",
    "@mastra/mcp": "1.9.1",
    "@mastra/memory": "1.20.2",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "ai": "^6.0.176",
    "cfonts": "^3.3.1",
    "diff": "^8.0.4",
    "execa": "^9.6.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "mastracode": "^0.22.2",
    "sharp": "^0.34.2",
    "shiki": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@codemap-ai/code-index": "workspace:*",
    "@mastra/core": "^1.41.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.12.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trieuluan/codemap.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/trieuluan/codemap#readme",
  "bugs": {
    "url": "https://github.com/trieuluan/codemap/issues"
  }
