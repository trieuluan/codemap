{
  "name": "@codemap-ai/cli",
  "version": "2.1.0",
  "type": "module",
  "description": "CodeMap — AI-powered coding agent CLI",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "codemap": "dist/index.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    "agent-pack",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "build:tsc": "tsc -p tsconfig.json",
    "dev": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev:watch": "NODE_NO_WARNINGS=1 tsx watch src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@codemap-ai/core": "workspace:*",
    "@codemap-ai/mcp": "workspace:*",
    "@codemap-ai/runtime-node": "workspace:*",
    "@earendil-works/pi-tui": "^0.74.0",
    "cfonts": "^3.3.1",
    "diff": "^8.0.4",
    "execa": "^9.6.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "sharp": "^0.34.2",
    "shiki": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@codemap-ai/code-index": "workspace:*",
    "@types/node": "^24.12.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trieuluan/codemap.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/trieuluan/codemap#readme",
  "bugs": {
    "url": "https://github.com/trieuluan/codemap/issues"
  }
}
