{
  "name": "@codemap-ai/core",
  "version": "3.1.1",
  "type": "module",
  "description": "CodeMap shared internal library",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./config.js": "./src/config.ts",
    "./lib/*.js": "./src/lib/*.ts",
    "./agent": "./src/agent/index.ts",
    "./agent/contracts": "./src/agent/contracts/index.ts",
    "./agent/session": "./src/agent/session/index.ts",
    "./agent/config": "./src/agent/config/index.ts",
    "./agent/loop": "./src/agent/loop/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@codemap-ai/code-index": "workspace:*",
    "@codemap-ai/shared": "workspace:*",
    "@manypkg/get-packages": "^3.1.0",
    "@mastra/core": "^1.42.0",
    "@mastra/fastembed": "1.1.2",
    "@mastra/libsql": "1.12.1",
    "@mastra/memory": "1.20.2",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@parcel/watcher": "^2.5.0",
    "ai": "^6.0.176",
    "jszip": "^3.10.1",
    "mastracode": "^0.22.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trieuluan/codemap.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/trieuluan/codemap#readme",
  "bugs": {
    "url": "https://github.com/trieuluan/codemap/issues"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "types": "dist/index.d.ts"
}
