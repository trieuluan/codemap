{
  "name": "@codemap/core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "CodeMap shared internal library",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config.js": "./src/config.ts",
    "./lib/*.js": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@codemap/code-index": "workspace:*",
    "@codemap/shared": "workspace:*",
    "@manypkg/get-packages": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "jszip": "^3.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
