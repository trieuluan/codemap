{
  "name": "@codemap-ai/desktop",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "CodeMap desktop coding agent",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:tsc": "tsc -p tsconfig.json --noEmit",
    "preview": "electron-vite preview",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "package:mac": "pnpm run build && electron-builder --mac"
  },
  "dependencies": {
    "@codemap-ai/core": "workspace:*",
    "@codemap-ai/runtime-node": "workspace:*",
    "@duckdb/node-api": "1.5.2-r.2",
    "@libsql/client": "^0.14.0",
    "@mastra/core": "^1.42.0",
    "@mastra/fastembed": "1.1.2",
    "@mastra/libsql": "1.12.1",
    "@mastra/mcp": "1.9.1",
    "@mastra/memory": "1.20.2",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-hover-card": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "ai": "^6.0.197",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.4",
    "gitdiff-parser": "^0.3.1",
    "mastracode": "^0.22.3",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "refractor": "^5.0.0",
    "sharp": "^0.34.2",
    "shiki": "^4.2.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/refractor": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "ai.codemap.desktop",
    "productName": "CodeMap",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
