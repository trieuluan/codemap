{
  "name": "codemap",
  "private": true,
  "version": "1.0.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:shared": "npm --workspace=@codemap/shared run build",
    "build:code-index": "npm --workspace=@codemap/code-index run build",
    "dev:api": "npm --workspace=@codemap/api run dev",
    "dev:worker": "npm --workspace=@codemap/api run dev:workers",
    "dev:workers": "npm --workspace=@codemap/api run dev:workers",
    "dev:worker:parses": "npm --workspace=@codemap/api run dev:worker:parses",
    "build:api": "npm run build:shared && npm run build:code-index && npm --workspace=@codemap/api run build:ts",
    "start:api": "npm --workspace=@codemap/api run start",
    "start:worker": "npm --workspace=@codemap/api run workers",
    "start:workers": "npm --workspace=@codemap/api run workers",
    "start:worker:parses": "npm --workspace=@codemap/api run worker:parses",
    "test:api": "npm run build:shared && npm run build:code-index && npm --workspace=@codemap/api run test",
    "dev:web": "npm --workspace=@codemap/web run dev",
    "build:web": "npm run build:shared && npm --workspace=@codemap/web run build",
    "preview:web": "npm --workspace=@codemap/web run start",
    "dev:mcp": "npm --workspace=@codemap-ai/cli run dev",
    "build:mcp": "npm run build:shared && npm run build:code-index && npm --workspace=@codemap-ai/cli run build",
    "start:mcp": "npm --workspace=@codemap-ai/cli run start",
    "version:patch": "npm version patch && pnpm version patch --filter @codemap-ai/cli --filter @codemap/api --filter @codemap/web --filter @codemap/shared --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "fastify-tsconfig": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
