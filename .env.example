# =============================================================================
# CodeMap — environment variables
# Copy this file to .env and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
HOST=0.0.0.0
COMPOSE_FILE=compose.dev.yml

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGIN=http://localhost:3000

# Public URL of the web app (used in OAuth redirects, emails, etc.)
WEB_APP_URL=http://localhost:3000

# API URL used by CLI and MCP tools to connect to the CodeMap API.
# Defaults to https://api.codemap.codes when unset.
# Override for local dev or self-hosted instances.
CODEMAP_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_IMAGE_TAG=18
POSTGRES_CONTAINER_NAME=codemap_pg
POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codemap
POSTGRES_PORT=5432

# Must match POSTGRES_* above. Inside Docker use the container name as host.
DATABASE_URL=postgresql://app:changeme@codemap_pg:5432/codemap

# -----------------------------------------------------------------------------
# Queue (Redis + BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# BullMQ queue names — change only if you run multiple environments on the same Redis
IMPORT_QUEUE_NAME=project-imports
PARSE_QUEUE_NAME=project-parses

# -----------------------------------------------------------------------------
# Auth (Better Auth)
# -----------------------------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters_here

# Base URL of the API server (used for OAuth callback construction)
BETTER_AUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Where cloned repositories and uploaded project zips are retained on disk.
# Maps to a Docker volume in compose. Leave unset to use ~/.codemap/data.
CODEMAP_STORAGE_ROOT=/codemap_storage

# Comma-separated list of local workspace paths the API is allowed to import.
# Required for local_workspace provider. Leave unset to allow all paths (dev only).
# CODEMAP_ALLOWED_WORKSPACE_ROOTS=/home/user/projects,/opt/repos

# -----------------------------------------------------------------------------
# GitHub OAuth  (optional — required for GitHub repo import)
# -----------------------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:3001/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/github/callback

# -----------------------------------------------------------------------------
# GitLab OAuth  (optional — required for GitLab repo import)
# -----------------------------------------------------------------------------
# Create an OAuth App at https://gitlab.com/-/profile/applications
# Callback URL: http://localhost:3001/gitlab/callback
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_OAUTH_CALLBACK_URL=http://localhost:3001/gitlab/callback

# -----------------------------------------------------------------------------
# Billing — PayPal  (optional — required for paid plans)
# -----------------------------------------------------------------------------
# Create an app at https://developer.paypal.com/dashboard/applications
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_PLAN_ID_DEVELOPER=
# PAYPAL_PLAN_ID_TEAM=
# PAYPAL_WEBHOOK_ID=

# -----------------------------------------------------------------------------
# Admin seed  (used by db:seed to create the initial admin user)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@codemap.local
ADMIN_NAME=CodeMap Admin
ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Code Embeddings  (optional — requires Ollama or OpenAI)
# -----------------------------------------------------------------------------
# Set to "true" to enable embedding generation during project import
ENABLE_CODE_EMBEDDINGS=false

# Provider: "ollama" (local native, free) or "openai" (cloud, requires API key)
# Ollama must be installed and running natively (not in Docker) for GPU support:
#   brew install ollama && ollama serve && ollama pull <model>
EMBEDDINGS_PROVIDER=ollama

# Ollama base URL:
#   API chạy natively (npm run dev:api) → http://localhost:11434
#   API chạy trong Docker               → http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embedding model. Options (lighter → heavier):
#   nomic-embed-text        (768 dims,  ~274MB, fast)
#   mxbai-embed-large       (1024 dims, ~670MB, good)
#   bge-m3                  (1024 dims, ~1.1GB, multilingual)
#   nomic-embed-text-v2-moe (768 dims,  ~500MB, multilingual MoE)
#   qwen3-embedding:0.6b    (1024 dims, ~400MB, best quality/size ratio)
#   qwen3-embedding:4b      (2560 dims, ~2.5GB, high quality)
# OpenAI: text-embedding-3-small | text-embedding-3-large | text-embedding-ada-002
EMBEDDINGS_MODEL=nomic-embed-text

# Output dimensions of the chosen model (used for DB storage and search filtering).
# Schema supports dynamic dims — no migration needed when switching models.
EMBEDDINGS_DIMENSIONS=768

EMBEDDINGS_BATCH_SIZE=64
EMBEDDINGS_TOKEN_BUDGET=50000

# Required only when EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# LLM Gateway CLI  (optional — used by packages/mcp-server `codemap` command)
# -----------------------------------------------------------------------------
# CODEMAP_LLM_GATEWAY_BASE_URL=http://localhost:4000/v1
# CODEMAP_LLM_GATEWAY_API_KEY=
# CODEMAP_LLM_GATEWAY_MODE=hybrid
# CODEMAP_LLM_GATEWAY_DEFAULT_MODEL=
# CODEMAP_LLM_GATEWAY_FAST_MODEL=auto.fast
# CODEMAP_LLM_GATEWAY_STRONG_MODEL=auto.strong
# CODEMAP_LLM_GATEWAY_LOCAL_MODEL=
